# SubCut Studio v2.3 Bold - Environment template
# Copy to .env and fill in real values for your local dev/prod environment.
# NEVER commit the real .env file.

# Auth secrets (use: python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_AUTH_SECRET=__REDACTED_SET_VIA_LOCAL_ENV__
APP_BROWSER_IDENTITY_SECRET=__REDACTED_SET_VIA_LOCAL_ENV__
APP_CLASS_SSO_SHARED_SECRET=__REDACTED_SET_VIA_LOCAL_ENV__

# Database
APP_DB_ENGINE=sqlite
APP_DB_PATH=./data/jobs.db

# Web server
APP_PYTHON_WEB_HOST=0.0.0.0
APP_PYTHON_WEB_PORT=18800
APP_PYTHON_WEB_RELOAD=0
APP_ENABLE_WORKER=0

# Storage / quota
APP_STORAGE_QUOTA_BYTES=53687091200
APP_USER_WORKSPACE_ROOT=./data/users
APP_SUBCUT_MAX_FILES=20
APP_SUBCUT_MAX_FILE_BYTES=10737418240
APP_OUTPUT_RETENTION_DAYS=30
APP_OUTPUT_RETENTION_EXTENSION_MAX_DAYS=14

# Worker / queue
APP_WORKER_MAX_CONCURRENCY=1
APP_WORKER_POLL_INTERVAL=1.0
APP_JOB_LEASE_TTL_SEC=120
APP_JOB_HEARTBEAT_INTERVAL_SEC=10

# Whisper / ASR
APP_WHISPER_ACTIVE_MODEL=Model_001
APP_WHISPER_REQUIRE_CUDA=1
APP_WHISPER_ALLOW_REMOTE_DOWNLOAD=1
APP_WHISPER_CACHE_MAX_MODELS=2
APP_WHISPER_UNLOAD_AFTER_RUN=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Encoding
APP_FORCE_VIDEO_ENCODER=libx264

# CORS (comma-separated)
CORS_ORIGINS=

# Auth settings
APP_AUTH_ACCESS_TTL_SEC=900
APP_AUTH_REFRESH_TTL_SEC=2592000
APP_AUTH_REQUIRED=0

# MiniMax (sandbox connector, NOT MiniMax public API)
MINIMAX_API_KEY=__REDACTED_SET_VIA_LOCAL_ENV__
AUTOSU_MINIMAX_SPELLFIX_ENABLED=0
