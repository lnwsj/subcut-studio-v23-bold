# Server
APP_PYTHON_WEB_HOST=0.0.0.0
APP_PYTHON_WEB_PORT=8787
APP_PYTHON_WEB_RELOAD=false

# Local database (default, ready for one server)
APP_DB_ENGINE=sqlite
APP_DB_PATH=./data/jobs.db
APP_USER_WORKSPACE_ROOT=./data/user_workspaces

# Security: replace with a long random value before exposing to the internet
APP_AUTH_REQUIRED=1
APP_AUTH_SECRET=replace-with-at-least-32-random-characters
# Keep this stable so anonymous Chrome workspaces remain recoverable
APP_BROWSER_IDENTITY_SECRET=replace-with-another-stable-random-secret
APP_AUTH_ACCESS_TTL_SEC=86400
APP_AUTH_REFRESH_TTL_SEC=2592000

# Background processing
APP_ENABLE_WORKER=1
APP_WORKER_MAX_CONCURRENCY=1
APP_WORKER_POLL_INTERVAL=1
APP_JOB_LEASE_TTL_SEC=90
APP_JOB_HEARTBEAT_INTERVAL_SEC=10
APP_SUBCUT_MAX_FILES=100
APP_SUBCUT_MAX_FILE_BYTES=21474836480
APP_STORAGE_QUOTA_BYTES=21474836480
APP_OUTPUT_RETENTION_DAYS=7
APP_OUTPUT_RETENTION_EXTENSION_MAX_DAYS=365

# Encoder: leave blank for automatic h264_nvenc -> libx264 fallback
APP_FORCE_VIDEO_ENCODER=

# Whisper — Balanced default for an 8 GB NVIDIA GPU
APP_WHISPER_ACTIVE_MODEL=Model_001
APP_WHISPER_MODEL_001_LABEL=Whisper Medium GPU
APP_WHISPER_MODEL_001_BACKEND=openai_whisper
APP_WHISPER_MODEL_001_SOURCE=medium
APP_WHISPER_MODEL_001_DEVICE=cuda
APP_WHISPER_MODEL_001_DTYPE=float16
APP_WHISPER_REQUIRE_CUDA=1
APP_WHISPER_ALLOW_REMOTE_DOWNLOAD=1
APP_WHISPER_CACHE_MAX_MODELS=1
APP_WHISPER_UNLOAD_AFTER_RUN=1

# Optional SSO — leave blank when using local accounts
APP_CLASS_SSO_EXCHANGE_URL=
APP_CLASS_SSO_SHARED_SECRET=

# Optional subtitle spell correction
AUTOSU_MINIMAX_SPELLFIX_ENABLED=0
MINIMAX_API_KEY=

# Comma-separated public origins when frontend/API are separated
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# MySQL migration example (uncomment and use the same existing member/job DB)
# APP_DB_ENGINE=mysql
# APP_DB_HOST=127.0.0.1
# APP_DB_PORT=3306
# APP_DB_USER=subcut
# APP_DB_PASSWORD=change-me
# APP_DB_NAME=subcut
