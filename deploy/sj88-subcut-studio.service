[Unit]
Description=SJ88 SubCut Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/sj88-subcut-studio
ExecStart=/opt/sj88-subcut-studio/scripts/start.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1

# Adjust for the server before enabling.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/sj88-subcut-studio/app/data /opt/sj88-subcut-studio/app/models /opt/sj88-subcut-studio/env

[Install]
WantedBy=multi-user.target
